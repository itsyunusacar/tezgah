    "Tezgah follows your system settings: Reduce Motion stops blinking and sliding; Increase Contrast darkens lines. States are never shown by colour alone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tezgah sistem ayarlarını izler: Hareketi Azalt yanıp sönmeleri ve kaymaları durdurur; Kontrastı Artır çizgileri koyulaştırır. Durumlar hiçbir yerde yalnızca renkle anlatılmaz."
          }
        }
      }
    },
